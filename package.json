{
  "name": "codex-clone",
  "displayName": "Codex Clone",
  "description": "A clean VS Code coding chat powered by xKiro's OpenAI GPT-5.3-Codex-Spark model.",
  "version": "0.0.4",
  "publisher": "inukaminsara",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:codexClone.openChat",
    "onCommand:codexClone.setApiKey",
    "onCommand:codexClone.clearApiKey"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "codexClone.openChat", "title": "Codex Clone: Open Chat" },
      { "command": "codexClone.setApiKey", "title": "Codex Clone: Set xKiro API Key" },
      { "command": "codexClone.clearApiKey", "title": "Codex Clone: Clear xKiro API Key" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "codexClone.openChat" },
        { "command": "codexClone.setApiKey" },
        { "command": "codexClone.clearApiKey" }
      ]
    },
    "configuration": {
      "title": "Codex Clone",
      "properties": {
        "codexClone.model": {
          "type": "string",
          "default": "openai/gpt-5.3-codex-spark",
          "description": "xKiro model ID used by Codex Clone."
        },
        "codexClone.reasoningEffort": {
          "type": "string",
          "enum": ["low", "medium", "high", "xhigh"],
          "default": "medium",
          "description": "Reasoning effort sent to xKiro."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^3.2.1"
  }
}
